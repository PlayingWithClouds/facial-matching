{
  "1": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "checkpoint (Lustify or another SDXL model)"},
        "inputs": {"ckpt_name": "cyberrealistic_xl_play_v10.safetensors"}},
  "2": {"class_type": "LoadImage", "_meta": {"title": "avatar render (views.py *_rgb.png)"},
        "inputs": {"image": "avatar_views/body_180_rgb.png"}},
  "3": {"class_type": "LoadImage", "_meta": {"title": "avatar depth (views.py *_depth.png)"},
        "inputs": {"image": "avatar_views/body_180_depth.png"}},
  "4": {"class_type": "ControlNetLoader", "_meta": {"title": "ControlNet Union SDXL (promax)"},
        "inputs": {"control_net_name": "controlnet-union-sdxl-promax.safetensors"}},
  "5": {"class_type": "SetUnionControlNetType", "_meta": {"title": "use it for depth"},
        "inputs": {"control_net": ["4", 0], "type": "depth"}},
  "6": {"class_type": "CLIPTextEncode", "_meta": {"title": "prompt"},
        "inputs": {"clip": ["1", 1], "text": "photo of a nude woman seen from behind, long straight dark brown hair, slim, tanned skin, plain light grey studio background, soft even studio lighting, sharp focus, realistic skin texture"}},
  "7": {"class_type": "CLIPTextEncode", "_meta": {"title": "negative prompt"},
        "inputs": {"clip": ["1", 1], "text": "clothes, underwear, cartoon, 3d render, cgi, painting, blurry, deformed, extra limbs, extra fingers, watermark, text"}},
  "8": {"class_type": "ControlNetApplyAdvanced", "_meta": {"title": "keep the avatar's shape (depth)"},
        "inputs": {"positive": ["6", 0], "negative": ["7", 0], "control_net": ["5", 0], "image": ["3", 0],
                   "strength": 0.8, "start_percent": 0.0, "end_percent": 0.8, "vae": ["1", 2]}},
  "9": {"class_type": "VAEEncode", "_meta": {"title": "start from the avatar render"},
        "inputs": {"pixels": ["2", 0], "vae": ["1", 2]}},
  "10": {"class_type": "KSampler", "_meta": {"title": "denoise: how much may change (0.3 little, 0.7 a lot)"},
         "inputs": {"model": ["1", 0], "positive": ["8", 0], "negative": ["8", 1], "latent_image": ["9", 0],
                    "seed": 1, "steps": 30, "cfg": 5.0, "sampler_name": "dpmpp_2m", "scheduler": "karras",
                    "denoise": 0.55}},
  "11": {"class_type": "VAEDecode", "inputs": {"samples": ["10", 0], "vae": ["1", 2]}},
  "12": {"class_type": "SaveImage", "inputs": {"images": ["11", 0], "filename_prefix": "avatar_view"}}
}
